# Copy to the repository root as .env for local development.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
DB_NAME=
DB_USER=cropchain_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500
FABRIC_MODE=disabled
FABRIC_GATEWAY_URL=http://127.0.0.1:8081
FABRIC_GATEWAY_TOKEN=
