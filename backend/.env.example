DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HTTPS=False

# mysql | sqlite
DB_ENGINE=mysql
DB_NAME=cropchain
DB_USER=cropchain_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
PUBLIC_PASSPORT_URL_TEMPLATE=http://127.0.0.1:5500/pages/track.html?batch={batch_code}

FABRIC_MODE=disabled
FABRIC_GATEWAY_URL=http://127.0.0.1:8081
FABRIC_GATEWAY_TOKEN=
FABRIC_TIMEOUT_SECONDS=15
FABRIC_MAX_ATTEMPTS=5

PRIVATE_MEDIA_ROOT=private_media
INSPECTOR_CAN_VIEW_ALL_BATCHES=True
LOG_LEVEL=INFO