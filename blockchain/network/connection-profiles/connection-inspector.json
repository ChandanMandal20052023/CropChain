{
  "name": "agrovaani-inspector-network",
  "version": "1.0.0",
  "client": {
    "organization": "InspectorOrg",
    "connection": {
      "timeout": { "peer": { "endorser": "300" }, "orderer": "300" }
    }
  },
  "organizations": {
    "InspectorOrg": {
      "mspid": "AgroVaaniInspectorMSP",
      "peers": ["peer0.inspector.agrovaani.com"],
      "certificateAuthorities": ["ca_inspector"]
    }
  },
  "peers": {
    "peer0.inspector.agrovaani.com": {
      "url": "grpcs://localhost:12051",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/inspector.agrovaani.com/tlsca/tlsca.inspector.agrovaani.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.inspector.agrovaani.com",
        "hostnameOverride": "peer0.inspector.agrovaani.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca_inspector": {
      "url": "https://localhost:12054",
      "caName": "ca-inspector",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/inspector.agrovaani.com/ca/ca.inspector.agrovaani.com-cert.pem"
      },
      "httpOptions": { "verify": false }
    }
  }
}
