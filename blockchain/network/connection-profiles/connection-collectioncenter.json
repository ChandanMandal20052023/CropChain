{
  "name": "agrovaani-collectioncenter-network",
  "version": "1.0.0",
  "client": {
    "organization": "CollectionCenterOrg",
    "connection": {
      "timeout": { "peer": { "endorser": "300" }, "orderer": "300" }
    }
  },
  "organizations": {
    "CollectionCenterOrg": {
      "mspid": "AgroVaaniCollectionCenterMSP",
      "peers": ["peer0.collectioncenter.agrovaani.com"],
      "certificateAuthorities": ["ca_collectioncenter"]
    }
  },
  "peers": {
    "peer0.collectioncenter.agrovaani.com": {
      "url": "grpcs://localhost:8051",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/collectioncenter.agrovaani.com/tlsca/tlsca.collectioncenter.agrovaani.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.collectioncenter.agrovaani.com",
        "hostnameOverride": "peer0.collectioncenter.agrovaani.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca_collectioncenter": {
      "url": "https://localhost:8054",
      "caName": "ca-collectioncenter",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/collectioncenter.agrovaani.com/ca/ca.collectioncenter.agrovaani.com-cert.pem"
      },
      "httpOptions": { "verify": false }
    }
  }
}
