{
  "name": "agrovaani-retailer-network",
  "version": "1.0.0",
  "client": {
    "organization": "RetailerOrg",
    "connection": {
      "timeout": { "peer": { "endorser": "300" }, "orderer": "300" }
    }
  },
  "organizations": {
    "RetailerOrg": {
      "mspid": "AgroVaaniRetailerMSP",
      "peers": ["peer0.retailer.agrovaani.com"],
      "certificateAuthorities": ["ca_retailer"]
    }
  },
  "peers": {
    "peer0.retailer.agrovaani.com": {
      "url": "grpcs://localhost:13051",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/retailer.agrovaani.com/tlsca/tlsca.retailer.agrovaani.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.retailer.agrovaani.com",
        "hostnameOverride": "peer0.retailer.agrovaani.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca_retailer": {
      "url": "https://localhost:13054",
      "caName": "ca-retailer",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/retailer.agrovaani.com/ca/ca.retailer.agrovaani.com-cert.pem"
      },
      "httpOptions": { "verify": false }
    }
  }
}
