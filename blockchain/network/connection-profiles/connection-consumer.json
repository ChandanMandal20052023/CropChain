{
  "name": "agrovaani-consumer-network",
  "version": "1.0.0",
  "client": {
    "organization": "ConsumerOrg",
    "connection": {
      "timeout": { "peer": { "endorser": "300" }, "orderer": "300" }
    }
  },
  "organizations": {
    "ConsumerOrg": {
      "mspid": "AgroVaaniConsumerMSP",
      "peers": ["peer0.consumer.agrovaani.com"],
      "certificateAuthorities": ["ca_consumer"]
    }
  },
  "peers": {
    "peer0.consumer.agrovaani.com": {
      "url": "grpcs://localhost:14051",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/consumer.agrovaani.com/tlsca/tlsca.consumer.agrovaani.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.consumer.agrovaani.com",
        "hostnameOverride": "peer0.consumer.agrovaani.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca_consumer": {
      "url": "https://localhost:14054",
      "caName": "ca-consumer",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/consumer.agrovaani.com/ca/ca.consumer.agrovaani.com-cert.pem"
      },
      "httpOptions": { "verify": false }
    }
  }
}
