{
  "name": "agrovaani-farmer-network",
  "version": "1.0.0",
  "client": {
    "organization": "FarmerOrg",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        },
        "orderer": "300"
      }
    }
  },
  "organizations": {
    "FarmerOrg": {
      "mspid": "AgroVaaniFarmerMSP",
      "peers": ["peer0.farmer.agrovaani.com"],
      "certificateAuthorities": ["ca_farmer"]
    }
  },
  "peers": {
    "peer0.farmer.agrovaani.com": {
      "url": "grpcs://localhost:7051",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/farmer.agrovaani.com/tlsca/tlsca.farmer.agrovaani.com-cert.pem"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.farmer.agrovaani.com",
        "hostnameOverride": "peer0.farmer.agrovaani.com"
      }
    }
  },
  "certificateAuthorities": {
    "ca_farmer": {
      "url": "https://localhost:7055",
      "caName": "ca-farmer",
      "tlsCACerts": {
        "path": "crypto-config/peerOrganizations/farmer.agrovaani.com/ca/ca.farmer.agrovaani.com-cert.pem"
      },
      "httpOptions": {
        "verify": false
      }
    }
  }
}
